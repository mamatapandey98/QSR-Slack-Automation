# Copy to .env and fill in. .env is gitignored.

# Slack bot token (xoxb-...). Required scopes:
#   chat:write, users:read, users:read.email, im:write (only if DMing)
SLACK_BOT_TOKEN=

# Channel for the round-1 announcement on the 1st of the month (ID like C0123ABCD, or #name).
# Required for reminder round 1. Rounds 2 and 3 are personal DMs and do not use this.
SLACK_REMINDER_CHANNEL=

# Optional: separate channel for a compliance digest alongside rounds 2/3. Blank = no digest.
SLACK_SUMMARY_CHANNEL=

# Base URL of Vyaguta. Override only if it changes.
VYAGUTA_BASE_URL=https://vyaguta.lftechnology.com
