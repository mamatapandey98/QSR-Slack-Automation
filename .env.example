# Copy to .env and fill in. .env is gitignored.

# Slack bot token (xoxb-...). Required scopes:
#   chat:write, users:read, users:read.email, im:write (only if DMing)
SLACK_BOT_TOKEN=

# Channel for the round-1 announcement on the 1st of the month (ID like C0123ABCD, or #name).
# Required for reminder round 1. Rounds 2 and 3 are personal DMs and do not use this.
SLACK_REMINDER_CHANNEL=

# Optional: separate channel for a compliance digest alongside rounds 2/3. Blank = no digest.
SLACK_SUMMARY_CHANNEL=

# Base URL of Vyaguta. Override only if it changes.
VYAGUTA_BASE_URL=https://vyaguta.lftechnology.com

# Vyaguta cookie credentials. How to get them:
#   1. Log into Vyaguta in your normal browser.
#   2. Open DevTools (F12) → Application tab → Cookies → https://vyaguta.lftechnology.com
#   3. Copy the "access_token" cookie value and paste below.
#   4. Copy the "refresh_token" cookie value and paste below.
# The refresh token (~7 day TTL) is used to auto-refresh the access token (~1 hour TTL),
# so you only need to re-paste when the refresh token itself expires.
VYAGUTA_ACCESS_TOKEN=
VYAGUTA_REFRESH_TOKEN=
