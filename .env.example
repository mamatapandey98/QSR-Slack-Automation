# Copy to .env and fill in. .env is gitignored.

# Slack bot token (xoxb-...). Required scopes:
#   chat:write, users:read, users:read.email, im:write (only if DMing)
SLACK_BOT_TOKEN=

# Channel to post the summary digest to (channel ID like C0123ABCD, or #name).
# Leave blank to skip the digest.
SLACK_SUMMARY_CHANNEL=

# Base URL of Vyaguta. Override only if it changes.
VYAGUTA_BASE_URL=https://vyaguta.lftechnology.com
