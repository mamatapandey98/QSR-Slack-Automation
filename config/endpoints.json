{
  "_comment": [
    "Filled in from out/api-discovery.json after running `npm run discover`.",
    "Paths may contain {month}, {year}, {projectId} placeholders.",
    "Each *Fields entry lists candidate keys in priority order; the first one present on a",
    "record wins. This absorbs naming differences without touching code."
  ],

  "projects": {
    "path": "/api/projects",
    "query": { "statusIds": "4,5", "size": "200", "sortBy": "projectName", "order": "asc" },
    "fields": {
      "id": ["id", "projectId"],
      "name": ["name", "projectName", "title"],
      "status": ["status", "projectStatus", "statusName"],
      "statusId": ["statusId", "status.id"],
      "inProduction": ["inProduction", "isInProduction", "productionStatus"],
      "ownerEmail": ["projectManagerEmail", "managerEmail", "owner.email", "manager.email"],
      "ownerName": ["projectManager", "manager.name", "owner.name"]
    }
  },

  "qsr": {
    "path": "/api/qsr",
    "query": { "month": "{month}", "year": "{year}" },
    "fields": {
      "projectId": ["projectId", "project.id"],
      "projectName": ["projectName", "project.name"],
      "month": ["month", "period", "reportMonth"],
      "submittedBy": ["submittedBy", "createdBy.email", "filledBy"],
      "submittedAt": ["submittedAt", "createdAt", "updatedAt"]
    }
  }
}
